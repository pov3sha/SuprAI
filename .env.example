# PostgreSQL Configuration
POSTGRES_USER=suprai_user
POSTGRES_PASSWORD=suprai_pass
POSTGRES_DB=suprai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://suprai_user:suprai_pass@postgres:5432/suprai_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=suprai-documents
MINIO_USE_SSL=false

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Fallback Default Model (used if role override is empty)
OLLAMA_DEFAULT_MODEL=qwen2.5:0.5b

# Role Overrides (Optional: leave empty to use OLLAMA_DEFAULT_MODEL)
OLLAMA_MANAGER_MODEL=
OLLAMA_CONSULTANT_MODEL=
OLLAMA_ANALYST_MODEL=
OLLAMA_RESEARCHER_MODEL=

DEFAULT_ORG_ID=default-org-uuid
DEFAULT_PROJECT_ID=default-project-uuid
