POSTGRES_USER=suprai_user
POSTGRES_PASSWORD=suprai_pass
POSTGRES_DB=suprai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://suprai_user:suprai_pass@postgres:5432/suprai_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=suprai-documents
MINIO_USE_SSL=false

# Provider API Credentials (Configure with your real API keys)
OPENAI_API_KEY=
GEMINI_API_KEY=

AI_DEFAULT_PROVIDER=openai

# Role Provider Routing (openai | gemini | ollama)
MANAGER_PROVIDER=openai
CONSULTANT_PROVIDER=gemini
ANALYST_PROVIDER=openai
RESEARCHER_PROVIDER=gemini

# Configurable Models Per Role
OPENAI_MANAGER_MODEL=gpt-4o-mini
OPENAI_CONSULTANT_MODEL=gpt-4o-mini
OPENAI_ANALYST_MODEL=gpt-4o-mini
OPENAI_RESEARCHER_MODEL=gpt-4o-mini

GEMINI_MANAGER_MODEL=gemini-1.5-flash
GEMINI_CONSULTANT_MODEL=gemini-1.5-flash
GEMINI_ANALYST_MODEL=gemini-1.5-flash
GEMINI_RESEARCHER_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:0.5b

DEFAULT_ORG_ID=default-org-uuid
DEFAULT_PROJECT_ID=default-project-uuid
